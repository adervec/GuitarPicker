# Dependencies — none are declared today (the app + tests use Node built-ins
# only), but guard against an accidental `npm install` ever vendoring a tree.
node_modules/

# Logs & debug output
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment / secrets (this app has none today — localStorage only — but
# don't let a stray .env get committed if that ever changes)
.env
.env.*
!.env.example

# OS cruft
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*~
